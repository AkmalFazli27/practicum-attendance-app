# Konfigurasi Firebase (Dapatkan dari Firebase Console > Project Settings > General > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tapin-attendance.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tapin-attendance
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=tapin-attendance.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Konfigurasi API Model AI Pengajar
# Endpoint API yang disediakan untuk klasifikasi kategori alasan izin (misalnya Sakit, Akademik, Mendesak, Pribadi)
EXPO_PUBLIC_AI_API_URL=https://api-ai-placeholder.edu/v1/classify-reason
EXPO_PUBLIC_AI_API_KEY=your_optional_api_key_here

