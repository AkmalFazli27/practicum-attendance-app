# Konfigurasi Firebase (Dapatkan dari Firebase Console > Project Settings > General > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tapin-attendance.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tapin-attendance
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=tapin-attendance.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Konfigurasi API Model AI Klasifikasi Alasan Izin
# Opsi 1 (Direkomendasikan — Gratis via Google AI Studio Free Tier):
# Buat API key gratis di https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
# Opsional: pilih model Gemini tertentu (default: gemini-2.5-flash-lite)
# EXPO_PUBLIC_AI_MODEL=gemini-2.5-flash-lite

# Opsi 2 (Alternatif — Endpoint OpenAI-compatible atau API Pengajar):
# EXPO_PUBLIC_AI_API_URL=https://api-ai-placeholder.edu/v1
# EXPO_PUBLIC_AI_API_KEY=your_optional_api_key_here
GOOGLE_MAPS_API_KEY=

# URL server pembayaran (tanpa garis miring di akhir)
EXPO_PUBLIC_PAYMENT_API_URL=
