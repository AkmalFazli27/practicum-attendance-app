{
  "expo": {
    "name": "TapIn",
    "slug": "tapin",
    "description": "Tap once. You're in. Sistem Informasi Praktikum.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tapin",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.tapin.praktikum"
    },
    "android": {
      "package": "id.tapin.praktikum",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TapIn memakai lokasimu untuk memeriksa apakah kamu berada di dalam radius laboratorium saat presensi."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TapIn memerlukan akses kamera untuk memindai kode QR presensi praktikum."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3682b5c2-861a-4d43-8cd5-eb72ba76e1ee"
      }
    },
    "owner": "nouvella"
  }
}