rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAsisten() {
      return userExists() && getUserData().peran == 'asisten';
    }

    function isPraktikan() {
      return userExists() && getUserData().peran == 'praktikan';
    }

    
    function isAslab() {
      return userExists() && getUserData().peran == 'aslab';
    }

    function sesiExists(sesiId) {
      return exists(/databases/$(database)/documents/sesi/$(sesiId));
    }

    function getSesiData(sesiId) {
      return get(/databases/$(database)/documents/sesi/$(sesiId)).data;
    }

    // Koleksi users: identitas dan peran pengguna
    match /users/{userId} {
          allow read: if isOwner(userId) || (isAsisten() || isAslab());

      // Registrasi mandiri dari klien hanya boleh membuat profil dengan peran 'praktikan'.
      // Akun 'asisten' diprovisikan melalui Firebase Console / Admin SDK.
      allow create: if isOwner(userId)
                    && request.resource.data.peran == 'praktikan'
                    && request.resource.data.keys().hasAll(['nama', 'email', 'peran'])
                    && request.resource.data.keys().hasOnly(['nama', 'email', 'peran', 'nim', 'kelas', 'createdAt']);

      // Pemilik tidak boleh mengubah 'peran'. pushToken boleh ditulis pemilik.
      allow update: if (isOwner(userId)
                        && request.resource.data.peran == resource.data.peran
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['peran', 'createdAt']))
                    || isAsisten();

      allow delete: if false;
    }

    // Koleksi labs: lokasi dan radius laboratorium
    // Dokumen dibuat lewat Firebase Console (seed). Klien hanya boleh membaca dan memperbarui koordinat/radius.
    match /labs/{labId} {
      allow read: if isAuthenticated();

      allow update: if isAsisten()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lat', 'lng', 'radius'])
                    && request.resource.data.lat is number
                    && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
                    && request.resource.data.lng is number
                    && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
                    && request.resource.data.radius is number
                    && request.resource.data.radius > 0;

      allow create, delete: if false;
    }

    // Koleksi sesi praktikum
    match /sesi/{sesiId} {
      allow read: if true;
      allow create, delete: if isAsisten();

      // PB-05: sesi yang sudah SELESAI tidak boleh dikembalikan ke status lain.
      allow update: if isAsisten()
                    && !(resource.data.status == 'SELESAI' && request.resource.data.status != 'SELESAI');
    }

    // Koleksi kehadiran
    match /kehadiran/{kehadiranId} {
      allow read: if (isAsisten() || isAslab())
                  || (isAuthenticated() && (resource == null || resource.data.praktikanId == request.auth.uid));

      // Praktikan hanya mencatat kehadiran untuk dirinya sendiri, ID ${sesiId}_${uid},
      // pada sesi yang berstatus DIBUKA, dengan koordinat dan jarak berupa angka.
      // Catatan: pengecekan jam dan radius dilakukan di aplikasi (markAttendance),
      // karena field status di Firestore tidak berubah sendiri saat jam selesai.
      allow create: if isPraktikan()
                    && request.resource.data.praktikanId == request.auth.uid
                    && request.resource.data.sesiId is string
                    && kehadiranId == request.resource.data.sesiId + '_' + request.auth.uid
                    && sesiExists(request.resource.data.sesiId)
                    && getSesiData(request.resource.data.sesiId).status == 'DIBUKA'
                    && !exists(/databases/$(database)/documents/izin/$(kehadiranId))
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    && request.resource.data.jarak is number
                    && request.resource.data.keys().hasOnly([
                         'sesiId', 'praktikanId', 'namaPraktikan', 'nimPraktikan',
                         'kelasPraktikan', 'waktuHadir', 'lat', 'lng', 'jarak', 'akurasi'
                       ]);

      allow update, delete: if isAsisten();
    }

    // Koleksi izin
    match /izin/{izinId} {
            allow read: if (isAsisten() || isAslab())
                  || (isAuthenticated() && (resource == null || resource.data.praktikanId == request.auth.uid));

      allow create: if isPraktikan()
                    && request.resource.data.praktikanId == request.auth.uid
                    && request.resource.data.status == 'MENUNGGU'
                    && request.resource.data.sesiId is string
                    && izinId == request.resource.data.sesiId + '_' + request.auth.uid
                    && sesiExists(request.resource.data.sesiId)
                    && getSesiData(request.resource.data.sesiId).status != 'SELESAI'
                    && !exists(/databases/$(database)/documents/kehadiran/$(izinId));

      allow update: if isAsisten()
                    && resource.data.status == 'MENUNGGU'
                    && (request.resource.data.status == 'DITERIMA' || request.resource.data.status == 'DITOLAK')
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'waktuKeputusan', 'reviewedAt', 'reviewedBy']);

      allow delete: if isAsisten();
    }
  }
}